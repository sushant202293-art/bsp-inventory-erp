# ============================================================
# BSP Inventory ERP - environment configuration
#
# Copy to .env and fill in the two Supabase values:
#   cp .env.example .env      (Windows: Copy-Item .env.example .env)
#
# Both values are in your Supabase dashboard:
#   Project Settings -> API
#
# Vite only reads .env at startup, so restart `npm run dev` after editing.
# .env is gitignored. Never commit a service-role / secret key.
# ============================================================

# Supabase project URL. Placeholder detection: keep this format so an
# unconfigured project shows the setup screen instead of failing silently.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable (or legacy anon) key. Safe to ship in a browser.
# The secret key shown on the same page is NOT safe - never use it here.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: API base path used by src/constants/index.ts. Defaults to /api.
# VITE_API_URL=/api


# ------------------------------------------------------------
# NOT configurable here
#
# Company identity (name, GSTIN, PAN, state, state_code, address, phone,
# email, website) is stored per-tenant in the `companies` table and read at
# runtime through CompanyContext. This app is multi-tenant, so these values
# must NOT be build-time constants - one .env cannot describe N companies.
# Edit them per company under Settings -> Company Profile.
#
# Currency (INR / Rs) and GST slabs are likewise fixed in
# src/config/app.config.ts, because the GST and formatting logic assumes
# INR with en-IN locale.
# ------------------------------------------------------------
