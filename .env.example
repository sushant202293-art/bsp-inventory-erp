# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
VITE_APP_NAME=BSP Inventory ERP
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Business Details
VITE_BUSINESS_NAME=Your Business Name
VITE_BUSINESS_GSTIN=22AAAAA0000A1Z5
VITE_BUSINESS_STATE=Maharashtra
VITE_BUSINESS_STATE_CODE=27
VITE_BUSINESS_ADDRESS="123 Business Street, Mumbai, Maharashtra 400001"
VITE_BUSINESS_PHONE=+91-9876543210
VITE_BUSINESS_EMAIL=business@example.com
VITE_BUSINESS_WEBSITE=https://example.com

# Currency Settings
VITE_CURRENCY_SYMBOL=₹
VITE_CURRENCY_CODE=INR
VITE_CURRENCY_LOCALE=en-IN

# Tax Configuration
VITE_DEFAULT_GST_RATE=18
VITE_CGST_RATE=9
VITE_SGST_RATE=9
VITE_IGST_RATE=18

# Feature Flags
VITE_ENABLE_MULTI_CURRENCY=false
VITE_ENABLE_BARCODE=false
VITE_ENABLE_GST_REPORTING=true
VITE_ENABLE_PAYMENT_GATEWAY=false

# Storage Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Logging
VITE_LOG_LEVEL=info
VITE_ENABLE_ANALYTICS=false
