{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "skipDefaultLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false,
    // Test files under src/**/__tests__ run in Node (they read source from
    // disk), so they need Node's module declarations. Application code must
    // still stay browser-safe; tsconfig.app.json is the browser config and
    // deliberately restricts types to "vite/client".
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build"]
}
